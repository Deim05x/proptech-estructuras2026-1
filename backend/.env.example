# Copia este archivo como .env.local y reemplaza los valores.
# .env.local esta ignorado por Git para proteger tus claves.

# IA real: usa openai o gemini
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=pon_tu_api_key_de_google_ai_studio
AI_MODEL=gemini-2.5-flash
# Para OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=pon_tu_api_key_de_openai
# AI_MODEL=gpt-4.1-mini
# AI_API_URL=

# Correo real por SMTP
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM=tu_correo@gmail.com
MAIL_FROM_NAME=HogarXpress
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_TIMEOUT=5000
