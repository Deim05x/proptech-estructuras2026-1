package "Service" as service {
  class AuthService <<Service>> {
    - authUsuarioRepository: AuthUsuarioRepository
    - authTokenRepository: AuthTokenRepository
    - clienteRepository: ClienteRepository
    - correoBienvenidaService: CorreoBienvenidaService
    + registrarCliente(): boolean
    + login(): LoginResponse
    + validarToken(): AuthToken
  }

  class SesionUsuarioService <<Service>> {
    - authUsuarioRepository: AuthUsuarioRepository
    + obtenerUsuarioAutenticado(): AuthUsuario
    + puedeAccederACliente(): boolean
  }

  class ClienteService <<Service>> {
    - clienteRepository: ClienteRepository
    + listarClientes(): Cliente[]
    + buscarPorId(): Cliente
    + agregarCliente(): boolean
    + actualizarCliente(): boolean
    + eliminarCliente(): boolean
  }

  class AsesorService <<Service>> {
    - asesorRepository: AsesorRepository
    + listarAsesores(): Asesor[]
    + buscarPorId(): Asesor
    + agregarAsesor(): boolean
    + actualizarAsesor(): boolean
    + eliminarAsesor(): boolean
  }

  class InmuebleService <<Service>> {
    - inmuebleRepository: InmuebleRepository
    + listarInmuebles(): Inmueble[]
    + buscarPorCodigo(): Inmueble
    + agregarInmueble(): boolean
    + actualizarInmueble(): boolean
    + eliminarInmueble(): boolean
    - asignarImagenPorDefecto(): void
  }

  class VisitaService <<Service>> {
    - visitaRepository: VisitaRepository
    - interaccionService: InteraccionService
    + agendarVisita(): boolean
    + reprogramarVisita(): boolean
    + cancelarVisita(): boolean
  }

  class OperacionService <<Service>> {
    - operacionRepository: OperacionRepository
    - inmuebleRepository: InmuebleRepository
    - clienteRepository: ClienteRepository
    - asesorRepository: AsesorRepository
    + registrarOperacion(): boolean
    + listarOperaciones(): Operacion[]
  }

  class ContratoService <<Service>> {
    - contratoRepository: ContratoRepository
    + crearContrato(): Contrato
    + listarVencidos(): Contrato[]
    + actualizarEstadosAutomaticos(): void
  }

  class SolicitudAtencionService <<Service>> {
    - solicitudAtencionRepository: SolicitudAtencionRepository
    - colaSolicitudes: Cola<SolicitudAtencion>
    - colaPrioridad: ColaPrioridad<SolicitudAtencion>
    + crearSolicitud(): SolicitudAtencion
    + procesarSiguiente(): SolicitudAtencion
  }

  class FavoritoService <<Service>> {
    - favoritoRepository: FavoritoRepository
    - clienteRepository: ClienteRepository
    - inmuebleRepository: InmuebleRepository
    - interaccionService: InteraccionService
    + agregarFavorito(): boolean
    + eliminarFavorito(): boolean
  }

  class InteraccionService <<Service>> {
    - interaccionRepository: InteraccionRepository
    + registrarInteraccion(): boolean
    + obtenerHistorialCliente(): Interaccion[]
  }

  class AlertaService <<Service>> {
    - alertaRepository: AlertaRepository
    - visitaService: VisitaService
    - inmuebleService: InmuebleService
    - operacionService: OperacionService
    - colaAlertas: Cola<Alerta>
    - colaPrioridad: ColaPrioridad<Alerta>
    + generarAlertasAutomaticas(): int
    + procesarSiguienteAlerta(): Alerta
  }

  class EventoInusualService <<Service>> {
    - eventoInusualRepository: EventoInusualRepository
    - inmuebleService: InmuebleService
    - visitaService: VisitaService
    - operacionService: OperacionService
    - alertaService: AlertaService
    + detectarEventosInusuales(): int
  }

  class ConsultaRangoPrecioService <<Service>> {
    - inmuebleRepository: InmuebleRepository
    + buscarPorRango(): Inmueble[]
    + listarOrdenadosPorPrecio(): Inmueble[]
  }

  class OrdenamientoInmuebleService <<Service>> {
    - inmuebleService: InmuebleService
    - visitaService: VisitaService
    + ordenarInmuebles(): Inmueble[]
  }

  class BusquedaHashService <<Service>> {
    - clienteRepository: ClienteRepository
    - inmuebleRepository: InmuebleRepository
    - asesorRepository: AsesorRepository
    + buscarClientePorId(): Object
    + buscarInmueblePorCodigo(): Object
  }

  class RecomendacionService <<Service>> {
    - clienteRepository: ClienteRepository
    - inmuebleService: InmuebleService
    + recomendarPorCliente(): Inmueble[]
  }

  class ReporteService <<Service>> {
    - inmuebleService: InmuebleService
    - visitaService: VisitaService
    - operacionService: OperacionService
    + generarResumenGeneral(): Object
    + generarReportesAgrupados(): Object[]
  }

  class GrafoRelacionesService <<Service>> {
    - inmuebleService: InmuebleService
    - visitaService: VisitaService
    - operacionService: OperacionService
    + listarNodos(): Object[]
    + listarRelaciones(): Object[]
  }

  class HistorialInmuebleService <<Service>> {
    - inmuebleRepository: InmuebleRepository
    - historialCambios: Pila<AccionInmueble>
    + capturarEstadoAntesDeCambio(): boolean
    + deshacerUltimoCambio(): Object
  }

  class CarruselInmuebleService <<Service>> {
    - inmuebleRepository: InmuebleRepository
    - carrusel: LinkedCircularDoubleList<Inmueble>
    + siguiente(): Inmueble
    + anterior(): Inmueble
  }

  class RotacionAsesorService <<Service>> {
    - asesorRepository: AsesorRepository
    - ruedaAsesores: LinkedCircularSimpleList<Asesor>
    + obtenerSiguienteAsesor(): Asesor
  }

  class MotorAlertasComercialesService <<Service>> {
    - contratoRepository: ContratoRepository
    - solicitudAtencionRepository: SolicitudAtencionRepository
    + generarAlertasComerciales(): Object[]
  }

  class ValidacionNegocioService <<Service>> {
    - clienteRepository: ClienteRepository
    - inmuebleRepository: InmuebleRepository
    - asesorRepository: AsesorRepository
    - visitaRepository: VisitaRepository
    - operacionRepository: OperacionRepository
    - contratoRepository: ContratoRepository
    - solicitudAtencionRepository: SolicitudAtencionRepository
    + validarReglasDeNegocio(): Object
  }

  class AsistenteVirtualService <<Service>> {
    - inmuebleService: InmuebleService
    - restClient: RestClient
    + responder(): AsistenteVirtualResponse
  }

  class CorreoBienvenidaService <<Service>> {
    - mailSender: JavaMailSender
    + enviarBienvenida(): void
  }
}

package "Repository" as repository {
  class ClienteRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + CRUD Cliente
  }

  class AsesorRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + CRUD Asesor
  }

  class InmuebleRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + CRUD Inmueble
  }

  class VisitaRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + CRUD Visita
    + reprogramar()
    + cancelar()
  }

  class OperacionRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + CRUD Operacion
  }

  class ContratoRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + CRUD Contrato
    + listarVencimientos()
  }

  class SolicitudAtencionRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + CRUD SolicitudAtencion
    + listarPendientes()
  }

  class FavoritoRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + guardarFavorito()
    + eliminarFavorito()
  }

  class InteraccionRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + guardarInteraccion()
    + obtenerHistorialPorCliente()
  }

  class AlertaRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + CRUD Alerta
    + actualizarEstado()
  }

  class EventoInusualRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + CRUD EventoInusual
    + actualizarEstado()
  }

  class AuthUsuarioRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + buscarPorUsername()
    + guardar()
  }

  class AuthTokenRepository <<Repository>> {
    - jdbcTemplate: JdbcTemplate
    + buscarTokenValido()
    + revocar()
  }
}

package "Model" as model {
  enum Role {
    ADMIN
    CLIENTE
  }

  class Cliente <<Model>> {
    - id: String
    - nombre: String
    - correo: String
    - telefono: String
    - tipoCliente: String
    - presupuesto: double
    - zonasInteres: String
    - tipoInmuebleDeseado: String
    - habitacionesMinimas: int
    - estadoBusqueda: String
  }

  class Asesor <<Model>> {
    - id: String
    - nombre: String
    - contacto: String
    - especialidadZona: String
    - cantidadCierres: int
  }

  class Inmueble <<Model>> {
    - codigo: String
    - direccion: String
    - ciudad: String
    - barrioZona: String
    - tipoInmueble: String
    - finalidad: String
    - precio: double
    - area: double
    - habitaciones: int
    - banos: int
    - estado: String
    - disponible: boolean
    - idAsesorResponsable: String
    - imagenUrl: String
  }

  class Visita <<Model>> {
    - id: int
    - idCliente: String
    - codigoInmueble: String
    - idAsesor: String
    - fecha: LocalDate
    - hora: LocalTime
    - estado: String
  }

  class Operacion <<Model>> {
    - id: String
    - codigoInmueble: String
    - idCliente: String
    - idAsesor: String
    - tipoOperacion: String
    - valorAcordado: double
    - estadoProceso: String
  }

  class Contrato <<Model>> {
    - id: String
    - codigoInmueble: String
    - idCliente: String
    - idAsesor: String
    - idOperacion: String
    - fechaInicio: LocalDate
    - fechaFin: LocalDate
    - valor: double
    + estaProximoAVencer(dias: int): boolean
    + estaVencido(): boolean
  }

  class SolicitudAtencion <<Model>> {
    - id: String
    - idCliente: String
    - codigoInmueble: String
    - idAsesorAsignado: String
    - tipoSolicitud: String
    - estado: String
    - prioridad: String
    + estaPendiente(): boolean
    + esAltaPrioridad(): boolean
  }

  class Interaccion <<Model>> {
    - id: int
    - idCliente: String
    - codigoInmueble: String
    - tipoInteraccion: String
    - fecha: LocalDateTime
  }

  class Alerta <<Model>> {
    - id: String
    - tipo: String
    - descripcion: String
    - nivelAtencion: String
    - estado: String
  }

  class EventoInusual <<Model>> {
    - id: String
    - tipo: String
    - descripcion: String
    - nivelAtencion: String
    - entidadReferencia: String
    - estado: String
  }

  class AuthUsuario <<Model>> {
    - id: int
    - username: String
    - passwordHash: String
    - rol: Role
    - clienteId: String
    - activo: boolean
  }

  class AuthToken <<Model>> {
    - id: int
    - token: String
    - username: String
    - rol: Role
    - clienteId: String
    - expiraEn: LocalDateTime
    - revocado: boolean
  }
}

package "DTO" as dto {
  class AsistenteVirtualRequest <<DTO>> {
    - mensaje: String
    - historial: List<ChatMessageDTO>
  }

  class AsistenteVirtualResponse <<DTO>> {
    - respuesta: String
    - generadoConIa: boolean
    - requiereRegistro: boolean
    - codigosSugeridos: List<String>
  }

  class ChatMessageDTO <<DTO>> {
    - role: String
    - content: String
  }
}

package "Estructuras" as estructuras {
  package "Listas" {
    class "LinkedSimpleList<T>" as LinkedSimpleList <<Estructura>> {
      - first: Node<T>
      - size: int
      + addLast(data: T): void
      + getNodeValue(index: int): T
    }

    class "LinkedDoubleList<T>" as LinkedDoubleList <<Estructura>> {
      - first: NodeDouble<T>
      - last: NodeDouble<T>
      - size: int
    }

    class "LinkedCircularSimpleList<T>" as LinkedCircularSimpleList <<Estructura>> {
      - first: NodeCircularSimple<T>
      - last: NodeCircularSimple<T>
      - size: int
    }

    class "LinkedCircularDoubleList<T>" as LinkedCircularDoubleList <<Estructura>> {
      - first: NodeCircularDouble<T>
      - last: NodeCircularDouble<T>
      - size: int
    }

    class "Node<T>" as NodeSimple <<Nodo>>
    class "NodeDouble<T>" as NodeDouble <<Nodo>>
    class "NodeCircularSimple<T>" as NodeCircularSimple <<Nodo>>
    class "NodeCircularDouble<T>" as NodeCircularDouble <<Nodo>>
  }

  package "Colas y pila" {
    class "Cola<T>" as Cola <<Estructura>> {
      - inicio: Nodo<T>
      - fin: Nodo<T>
      + encolar(dato: T): void
      + desencolar(): T
    }

    class "ColaPrioridad<T>" as ColaPrioridad <<Estructura>> {
      - inicio: NodoPrioridad<T>
      + encolar(dato: T, prioridad: int): void
      + desencolar(): T
    }

    class "Pila<T>" as Pila <<Estructura>> {
      - cima: NodoPila<T>
      + apilar(dato: T): void
      + desapilar(): T
    }

    class "Nodo<T>" as NodoCola <<Nodo>>
    class "NodoPrioridad<T>" as NodoPrioridad <<Nodo>>
    class "NodoPila<T>" as NodoPila <<Nodo>>
  }

  package "Arboles, hash y grafos" {
    class "ArbolBinarioBusqueda<T>" as ArbolBinarioBusqueda <<Estructura>> {
      - raiz: NodoArbol<T>
      + insertar(dato: T): void
      + llenarInOrdenAscendente(arreglo: T[]): void
    }

    class ArbolPrecioInmuebles <<Estructura>> {
      - raiz: NodoArbolPrecio
      + insertar(inmueble: Inmueble): void
      + buscarPorRango(min: double, max: double): LinkedSimpleList<Inmueble>
    }

    class "TablaHash<K,V>" as TablaHash <<Estructura>> {
      - tabla: NodoHash<K,V>[]
      + poner(clave: K, valor: V): void
      + obtener(clave: K): V
    }

    class "TablaHashPropia<K,V>" as TablaHashPropia <<Estructura>> {
      - tabla: EntradaHash<K,V>[]
      - colisiones: int
      + insertar(clave: K, valor: V): void
      + buscar(clave: K): V
    }

    class "GrafoNoDirigido<T>" as GrafoNoDirigido <<Estructura>> {
      - vertices: Object[]
      - matrizAdyacencia: double[][]
      + agregarVertice(dato: T): boolean
      + agregarArista(origen: T, destino: T, peso: double): void
    }

    class "NodoArbol<T>" as NodoArbol <<Nodo>>
    class NodoArbolPrecio <<Nodo>>
    class "NodoHash<K,V>" as NodoHash <<Nodo>>
    class "EntradaHash<K,V>" as EntradaHash <<Nodo>>
  }
}

