title Diagrama de clases organizado - Backend HogarXpress

package "Config" as config {
  class BackendApplication <<SpringBootApplication>> {
    + main(args: String[]): void
  }

  class SecurityConfig <<Configuration>> {
    + passwordEncoder(): PasswordEncoder
    + corsConfigurationSource(): CorsConfigurationSource
    + securityFilterChain(...): SecurityFilterChain
  }

  class CorsConfig <<Configuration>> {
    + corsConfigurer(): WebMvcConfigurer
  }
}

package "Security" as security {
  class TokenAuthenticationFilter <<Filter>> {
    - authService: AuthService
    # doFilterInternal(...): void
  }

  class CustomUserDetailsService <<Service>> {
    - authUsuarioRepository: AuthUsuarioRepository
    + loadUserByUsername(username: String): UserDetails
  }
}

package "Controller" as controller {
  class AuthController <<RestController>> {
    - authService: AuthService
  }

  class ClienteController <<RestController>> {
    - clienteService: ClienteService
  }

  class AsesorController <<RestController>> {
    - asesorService: AsesorService
  }

  class InmuebleController <<RestController>> {
    - inmuebleService: InmuebleService
  }

  class VisitaController <<RestController>> {
    - visitaService: VisitaService
  }

  class OperacionController <<RestController>> {
    - operacionService: OperacionService
  }

  class ContratoController <<RestController>> {
    - contratoService: ContratoService
  }

  class SolicitudAtencionController <<RestController>> {
    - solicitudAtencionService: SolicitudAtencionService
  }

  class FavoritoController <<RestController>> {
    - favoritoService: FavoritoService
    - interaccionService: InteraccionService
    - sesionUsuarioService: SesionUsuarioService
  }

  class InteraccionController <<RestController>> {
    - interaccionService: InteraccionService
    - sesionUsuarioService: SesionUsuarioService
  }

  class AlertaController <<RestController>> {
    - alertaService: AlertaService
  }

  class EventoInusualController <<RestController>> {
    - eventoInusualService: EventoInusualService
  }

  class ConsultaRangoPrecioController <<RestController>> {
    - consultaRangoPrecioService: ConsultaRangoPrecioService
  }

  class OrdenamientoInmuebleController <<RestController>> {
    - ordenamientoInmuebleService: OrdenamientoInmuebleService
  }

  class BusquedaHashController <<RestController>> {
    - busquedaHashService: BusquedaHashService
  }

  class RecomendacionController <<RestController>> {
    - recomendacionService: RecomendacionService
    - sesionUsuarioService: SesionUsuarioService
  }

  class ReporteController <<RestController>> {
    - reporteService: ReporteService
  }

  class GrafoRelacionesController <<RestController>> {
    - grafoRelacionesService: GrafoRelacionesService
  }

  class HistorialInmuebleController <<RestController>> {
    - historialInmuebleService: HistorialInmuebleService
  }

  class CarruselInmuebleController <<RestController>> {
    - carruselInmuebleService: CarruselInmuebleService
  }

  class RotacionAsesorController <<RestController>> {
    - rotacionAsesorService: RotacionAsesorService
  }

  class MotorAlertasComercialesController <<RestController>> {
    - motorAlertasComercialesService: MotorAlertasComercialesService
  }

  class ValidacionNegocioController <<RestController>> {
    - validacionNegocioService: ValidacionNegocioService
  }

  class AsistenteVirtualController <<RestController>> {
